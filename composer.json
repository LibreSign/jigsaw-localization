{
    "name": "libresign/jigsaw-localization",
    "description": "Localization and translation toolkit for Tighten Jigsaw with JSON catalogs, extraction, validation, and locale-aware routing",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Ilies BOUDOUMA",
            "email": "medilies.contact@gmail.com",
            "role": "Original author"
        },
        {
            "name": "LibreSign",
            "homepage": "https://libresign.coop",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/intl": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "tightenco/jigsaw": "^1.7"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "LibreSign\\JigsawLocalization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests",
            "LibreSign\\JigsawLocalization\\Mocks\\": "tests/_Mocks"
        }
    },
    "scripts": {
        "analyse": "vendor-bin/phpstan/vendor/bin/phpstan analyse --no-progress",
        "test": "vendor-bin/phpunit/vendor/bin/phpunit --colors=always",
        "format": "vendor-bin/pint/vendor/bin/pint",
        "ci": [
            "@test",
            "@analyse",
            "@complexity",
            "vendor-bin/pint/vendor/bin/pint --test"
        ],
        "complexity": "vendor-bin/phpmd/vendor/bin/phpmd src text phpmd.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-intl": "For locale display name resolution"
    },
    "keywords": [
        "jigsaw",
        "localization",
        "translation",
        "internationalization",
        "i18n",
        "static-site-generator",
        "blade"
    ],
    "homepage": "https://github.com/LibreSign/jigsaw-localization",
    "support": {
        "issues": "https://github.com/LibreSign/jigsaw-localization/issues",
        "source": "https://github.com/LibreSign/jigsaw-localization"
    }
}

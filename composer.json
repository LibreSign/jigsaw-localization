{
    "name": "elaborate-code/jigsaw-localization",
    "description": "Brings localization feature to \"tightenco/jigsaw\" using JSON files",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Ilies BOUDOUMA",
            "email": "medilies.contact@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "elaborate-code/php-json-tongue": "^1.0",
        "symfony/intl": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "tightenco/jigsaw": "^1.7"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "ElaborateCode\\JigsawLocalization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests",
            "ElaborateCode\\JigsawLocalization\\Mocks\\": "tests/_Mocks"
        }
    },
    "scripts": {
        "analyse": "vendor-bin/phpstan/vendor/bin/phpstan analyse --no-progress",
        "test": "vendor-bin/phpunit/vendor/bin/phpunit --colors=always",
        "format": "vendor-bin/pint/vendor/bin/pint",
        "ci": [
            "@test",
            "@analyse",
            "@complexity",
            "vendor-bin/pint/vendor/bin/pint --test"
        ],
        "complexity": "vendor-bin/phpmd/vendor/bin/phpmd src text phpmd.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-intl": "For locale display name resolution"
    }
}
